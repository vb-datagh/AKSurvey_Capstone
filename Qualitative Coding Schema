<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Qualitative Coding Schema</title>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500&display=swap" rel="stylesheet">
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 300;
    background: #ffffff;
    color: #111111;
    font-size: 15px;
    line-height: 1.65;
    max-width: 760px;
    margin: 0 auto;
    padding: 64px 32px 96px;
  }

  /* HEADER */
  .site-header {
    border-bottom: 2px solid #111;
    padding-bottom: 24px;
    margin-bottom: 48px;
  }

  .site-header h1 {
    font-size: 22px;
    font-weight: 500;
    letter-spacing: -0.01em;
    margin-bottom: 8px;
  }

  .header-meta {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #888;
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
  }

  /* SECTION */
  .section {
    margin-bottom: 56px;
  }

  .section-title {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 16px;
  }

  /* BIO */
  .bio p {
    color: #333;
    margin-bottom: 12px;
    max-width: 640px;
  }

  .bio p:last-child { margin-bottom: 0; }

  /* PROCESS LIST */
  .process-list {
    list-style: none;
    counter-reset: steps;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .process-list li {
    counter-increment: steps;
    display: grid;
    grid-template-columns: 28px 1fr;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid #ebebeb;
    align-items: start;
  }

  .process-list li:first-child { border-top: 1px solid #ebebeb; }

  .process-list li::before {
    content: counter(steps);
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    color: #bbb;
    padding-top: 2px;
  }

  .process-list li .step-name {
    font-weight: 500;
    display: block;
    margin-bottom: 2px;
  }

  .process-list li .step-desc {
    font-size: 14px;
    color: #555;
  }

  /* TABLE */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
  }

  thead tr {
    border-bottom: 2px solid #111;
  }

  th {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #888;
    font-weight: 400;
    padding: 0 12px 10px 0;
    text-align: left;
  }

  th:first-child { width: 52px; }
  th:nth-child(2) { width: 160px; }

  td {
    padding: 12px 12px 12px 0;
    vertical-align: top;
    border-bottom: 1px solid #ebebeb;
    color: #222;
    line-height: 1.5;
  }

  .code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 12px;
    font-weight: 500;
    color: #111;
  }

  .label { font-weight: 500; }

  .example {
    font-style: italic;
    color: #888;
    font-size: 13px;
  }

  .dim { color: #bbb; font-family: 'IBM Plex Mono', monospace; font-size: 12px; }

  /* SENTIMENT GRID */
  .sent-row {
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 0;
    border-bottom: 1px solid #ebebeb;
    padding: 12px 0;
    font-size: 14px;
  }

  .sent-row:first-of-type { border-top: 2px solid #111; }

  .sent-code {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 14px;
    font-weight: 500;
    padding-top: 1px;
  }

  .sent-code.pos { color: #16a34a; }
  .sent-code.neu { color: #ca8a04; }
  .sent-code.neg { color: #dc2626; }

  .sent-body .sent-label { font-weight: 500; }
  .sent-body .sent-def { color: #555; font-size: 13px; }

  /* FOOTER */
  footer {
    margin-top: 64px;
    padding-top: 20px;
    border-top: 1px solid #ebebeb;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 11px;
    color: #bbb;
  }
</style>
</head>
<body>

<header class="site-header">
  <h1>Qualitative Coding Schema</h1>
  <div class="header-meta">
    <span>AKI 2025 Filipinx Community Survey — Sacramento Region</span>
    <span>Unit: Individual open-ended survey response</span>
    <span>Goal: Theme area + sentiment classification</span>
  </div>
</header>

<!-- ISSUE AREA CODES -->
<div class="section">
  <div class="section-title">Top-Level Codes — Theme Areas</div>
  <table>
    <thead>
      <tr>
        <th>Code</th>
        <th>Label</th>
        <th>Definition</th>
        <th>Example Response</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td><span class="code">EW</span></td>
        <td><span class="label">Economic Wellbeing</span></td>
        <td>References to income, employment, financial stress, debt, remittances, or cost of living burden</td>
        <td><span class="example">Most of my paycheck goes to rent and sending money home</span></td>
      </tr>
      <tr>
        <td><span class="code">MH</span></td>
        <td><span class="label">Mental Health</span></td>
        <td>Stress, anxiety, depression, access to mental health care, or emotional wellbeing</td>
        <td><span class="example">I've been struggling but can't afford a therapist</span></td>
      </tr>
      <tr>
        <td><span class="code">HO</span></td>
        <td><span class="label">Housing</span></td>
        <td>Housing stability, homeownership, rent burden, household composition, or housing access</td>
        <td><span class="example">We have six people in a two-bedroom apartment</span></td>
      </tr>
      <tr>
        <td><span class="code">ID</span></td>
        <td><span class="label">Identity &amp; Community</span></td>
        <td>Filipinx/Filipino-American identity, generational status, language, cultural connection, or community belonging</td>
        <td><span class="example">I grew up here but still feel like I have to prove I belong</span></td>
      </tr>
      <tr>
        <td><span class="code">CI</span></td>
        <td><span class="label">Civic &amp; Political Engagement</span></td>
        <td>Voter registration, voting behavior, political affiliation, or civic participation</td>
        <td><span class="example">I voted for the first time in 2020 and it felt important</span></td>
      </tr>
      <tr>
        <td><span class="code">SA</span></td>
        <td><span class="label">Safety &amp; Discrimination</span></td>
        <td>Hate incidents, harassment, physical or emotional abuse, or experiences of discrimination</td>
        <td><span class="example">Someone yelled at me to go back to my country at the grocery store</span></td>
      </tr>
      <tr>
        <td><span class="code">ED</span></td>
        <td><span class="label">Education</span></td>
        <td>Educational attainment, student debt, school enrollment, or access to education</td>
        <td><span class="example">My parents sacrificed everything so I could finish my degree</span></td>
      </tr>
      <tr>
        <td><span class="code">IM</span></td>
        <td><span class="label">Immigration &amp; Transnational Ties</span></td>
        <td>Citizenship status, visa, DACA, country of birth, family in the Philippines, or remittances</td>
        <td><span class="example">I send money home every month even when I can barely cover my bills</span></td>
      </tr>
      <tr>
        <td><span class="code">FN</span></td>
        <td><span class="label">Food &amp; Nutrition</span></td>
        <td>Food security, food access, grocery habits, or participation in food assistance programs</td>
        <td><span class="example">There's no Filipino grocery near us so we drive 45 minutes</span></td>
      </tr>
      <tr>
        <td><span class="code">OT</span></td>
        <td><span class="label">Other</span></td>
        <td>Relevant but doesn't fit above categories</td>
        <td><span class="dim">—</span></td>
      </tr>
      <tr>
        <td><span class="code">UN</span></td>
        <td><span class="label">Uncategorizable</span></td>
        <td>Too vague or off-topic to code</td>
        <td><span class="example">No comment</span></td>
      </tr>
    </tbody>
  </table>
</div>

<!-- SENTIMENT CODES -->
<div class="section">
  <div class="section-title">Sentiment Codes — Applied alongside issue code</div>
  <div class="sent-row">
    <div class="sent-code pos">+1</div>
    <div class="sent-body">
      <div class="sent-label">Positive</div>
      <div class="sent-def">Hopeful, motivated, or optimistic tone</div>
    </div>
  </div>
  <div class="sent-row">
    <div class="sent-code neu">0</div>
    <div class="sent-body">
      <div class="sent-label">Neutral</div>
      <div class="sent-def">Factual or ambiguous; no clear valence</div>
    </div>
  </div>
  <div class="sent-row">
    <div class="sent-code neg">−1</div>
    <div class="sent-body">
      <div class="sent-label">Negative</div>
      <div class="sent-def">Frustrated, despairing, or cynical tone</div>
    </div>
  </div>
</div>

<footer>
  AKI 2025 Filipinx Community Survey &nbsp;·&nbsp; Qualitative Coding Schema
</footer>

</body>
</html>
